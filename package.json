{
  "name": "mike-zhang-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "vite build && node scripts/check-dist.mjs",
    "preview": "vite preview --host 127.0.0.1",
